ENTORNO=desarrollo

DB_URL=mysql+pymysql://usuario:contrasena@localhost:3306/verificentro?charset=utf8mb4
#
# En Aiven la conexión exige cifrado. Descarga su archivo ca.pem, ponlo en
# esta misma carpeta y agrégalo al final:
#   ...?charset=utf8mb4&ssl_ca=ca.pem
#
# Poner en true solo para depurar: imprime cada consulta SQL.
DB_ECHO=false
# Conexiones simultáneas. Los planes gratuitos dan pocas; no los subas sin
# necesidad o la base empieza a rechazar.
DB_POOL=3
DB_POOL_EXTRA=2

# OBLIGATORIO cambiarlo antes de producción: con ENTORNO=produccion el
# servidor se niega a arrancar si sigue el de ejemplo o mide menos de 32
# caracteres. Genera uno con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRETO=cambiar-esto-por-uno-generado-de-al-menos-32-caracteres
JWT_MINUTOS_VIGENCIA=480

# 'consola' imprime los mensajes en pantalla en lugar de enviarlos.
# Permite construir y probar todo el flujo sin depender de Meta.
# Por qué canales se generan recordatorios. Mientras no esté el trámite con
# Meta, déjalo solo en correo: así no se acumulan mensajes de WhatsApp que no
# se van a poder enviar.
#   ["correo"]              solo correo
#   ["correo","whatsapp"]   los dos
CANALES_ACTIVOS=["correo"]

PROVEEDOR_WHATSAPP=consola
# El correo NO depende de Meta: en cuanto pongas credenciales SMTP,
# cámbialo a 'smtp' y empieza a enviar de verdad.
PROVEEDOR_CORREO=consola

# Token permanente del usuario del sistema (no el temporal de 24 h).
WHATSAPP_TOKEN=
# ID del número, no el número. Se ve en el panel de la app en Meta.
WHATSAPP_PHONE_ID=
# Lo inventas tú y lo pones igual aquí y en el panel de webhooks de Meta.
WHATSAPP_VERIFY_TOKEN=
# Secreto de la app, para comprobar la firma de los webhooks. Obligatorio en
# producción: sin él cualquiera podría mandar acuses falsos.
WHATSAPP_APP_SECRET=
# Tiene que coincidir con el idioma de las plantillas aprobadas.
WHATSAPP_IDIOMA=es_MX

# Puerto 587 con STARTTLS, o 465 con SSL directo.
#
# Para Gmail: la contraseña NO es la de la cuenta, es una CONTRASEÑA DE
# APLICACIÓN de 16 caracteres que se genera en
# https://myaccount.google.com/apppasswords (requiere verificación en dos
# pasos activada). Y CORREO_REMITENTE tiene que ser la misma cuenta que
# SMTP_USUARIO, o Google reescribe el remitente.
SMTP_HOST=smtp.gmail.com
SMTP_PUERTO=587
SMTP_USUARIO=verificentroruizcortinesx@gmail.com
SMTP_CONTRASENA=
CORREO_REMITENTE=verificentroruizcortinesx@gmail.com
NOMBRE_REMITENTE=Verificentro

# Dónde vive el backend de cara al mundo. Es lo que va en los enlaces de los
# correos, así que en producción NO puede ser localhost.
URL_PUBLICA=http://localhost:8000
# A dónde llega el cliente al dar clic en el correo.
URL_CONSULTA=http://localhost:5173/consulta

# Desde qué direcciones se acepta al frontend. En producción va el dominio de
# Netlify; si no está aquí, el navegador bloquea las peticiones y la pantalla
# se queda en blanco sin decir por qué.
ORIGENES_PERMITIDOS=["http://localhost:5173"]
