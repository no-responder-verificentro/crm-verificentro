# Copia este archivo como .env y ajusta la dirección.
#
#     copy .env.example .env
#
# Ojo: en Vite estas variables se incrustan AL COMPILAR, no se leen al abrir
# la página. Si la cambias, hay que volver a compilar y volver a desplegar.
#
# Y ojo también con el /api/v1 del final: sin eso no funciona nada.

# En tu computadora:
VITE_API_URL=http://localhost:8000/api/v1

# Desde otra computadora de la misma red (la IP sale con ipconfig):
# VITE_API_URL=http://192.168.1.50:8000/api/v1

# En producción, la URL que te dio Render:
# VITE_API_URL=https://verificentro-api.onrender.com/api/v1
