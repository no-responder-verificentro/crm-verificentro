# Copia este archivo como .env y llena los valores.
#
#     copy .env.example .env
#
# El .env NO se sube a Git: está en el .gitignore y ahí tienen que seguir
# las contraseñas de verdad.

# --- Aplicación ---
# desarrollo | pruebas | produccion
ENTORNO=desarrollo

# --- Base de datos ---
# En tu computadora:
DB_URL=mysql+pymysql://root:TU_CONTRASENA@localhost:3306/verificentro?charset=utf8mb4
# Alternativa al archivo backend/ca.pem: pega aquí el certificado completo,
# con sus líneas BEGIN y END. Útil en Render, y evita que un `*.pem` en el
# .gitignore deje el archivo fuera del repositorio sin avisar.
DB_CA_PEM=

# En Aiven (ojo con el puerto, no es 3306, y con el ssl_ca):
# DB_URL=mysql+pymysql://avnadmin:LA-CONTRASENA@EL-HOST:EL-PUERTO/verificentro?charset=utf8mb4&ssl_ca=ca.pem

# --- Seguridad ---
# Genéralo con:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
# Con ENTORNO=produccion el servidor se niega a arrancar si dejas el de ejemplo.
JWT_SECRETO=solo-para-desarrollo-cambiar-esto-antes-de-produccion

# --- Mensajería ---
# Mientras no esté el trámite con Meta, solo correo.
CANALES_ACTIVOS=["correo"]

# POR DONDE SALEN LOS CORREOS. La variable que más problemas causa.
#
#   consola     -> los imprime en pantalla y NO manda nada, pero los reporta
#                  como enviados. Es el valor por omisión, y la explicación
#                  número uno de "dice enviado y no llega, ni a spam".
#   mailjet     -> la API de Mailjet. NO su SMTP: por SMTP contesta 250 OK y
#                  después descarta el mensaje con su filtro antispam, y eso
#                  era indistinguible de un envío bueno.
#   apps_script -> una app web de Google Apps Script
#   smtp        -> servidor de correo clásico (Gmail con contraseña de app)
#
# El paso a paso de las dos opciones está en CONECTAR_CORREO.md.
PROVEEDOR_CORREO=consola

# --- Opción mailjet ---
# Mailjet -> Account settings -> API Key Management.
MAILJET_API_KEY=
MAILJET_API_SECRET=
# Va dentro de la dirección del webhook, porque Mailjet no firma sus eventos:
#     https://TU-API/webhooks/mailjet/ESTE-SECRETO
# Sin webhook no hay acuses de entrega ni se sabe si bloquearon un correo.
MAILJET_WEBHOOK_SECRETO=

# --- Opción apps_script ---
# La dirección de la implementación, la que termina en /exec. La de /dev es
# la de pruebas y solo responde si tú tienes la sesión abierta.
APPS_SCRIPT_URL=
# Lo inventas tú y tiene que ser el mismo que está dentro del script:
#     python -c "import secrets; print(secrets.token_urlsafe(32))"
APPS_SCRIPT_TOKEN=

# --- Opción smtp ---
SMTP_HOST=smtp.gmail.com
SMTP_PUERTO=587
SMTP_USUARIO=no.responder.verificentro@gmail.com
SMTP_CONTRASENA=la-contrasena-de-aplicacion-de-gmail
CORREO_REMITENTE=no.responder.verificentro@gmail.com
NOMBRE_REMITENTE=Verificentro

# WhatsApp: se llena cuando Meta apruebe. Ver CONECTAR_WHATSAPP.md.
PROVEEDOR_WHATSAPP=consola
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_IDIOMA=es_MX

# --- Direcciones ---
# Dónde vive el backend de cara al mundo. Es lo que va en los enlaces de los
# correos, así que en producción no puede ser localhost.
URL_PUBLICA=http://localhost:8000
# A dónde llega el cliente al dar clic en el correo.
URL_CONSULTA=http://localhost:5173/consulta

# --- CORS ---
# Qué dominios pueden llamar a la API. En producción, el de Netlify, con
# https:// y sin barra al final. Si falta, la pantalla de inicio de sesión se
# queda cargando sin mostrar ningún error.
ORIGENES_PERMITIDOS=["http://localhost:5173"]
